# Alternative to Caddyfile.example. Replace every <PLACEHOLDER>. See README.md, section "Placeholders". (muas Mosl macha)
# Add the two location blocks to the existing server block of <API_DOMAIN>. (muas Mosl macha)
location /feedback {
    proxy_pass http://127.0.0.1:<PORT>;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
}

location = /health {
    proxy_pass http://127.0.0.1:<PORT>;
}
